OPENAI_API_KEY=
PORT=4000

# 本番投入前に必ず固有の値を設定すること（未設定だとコード内の開発用デフォルト値で署名される）
ADMIN_JWT_SECRET=
STUDENT_JWT_SECRET=

# 最初の運営管理者アカウント（本番では必須。管理者が1人もいないときだけ作られ、初回ログイン後にパスワード変更を強制する）
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
# 本番で開発用のモックデータ（生徒25人など）を入れたい場合のみ 1（通常は不要）
# SEED_MOCK_DATA=

# 管理画面のオリジン（カンマ区切り。例: https://admin.example.com）。未設定だと全オリジンを許可する（本番では設定すること）
CORS_ORIGINS=
# リバースプロキシ（nginx・ALBなど）の背後で動かす場合の段数（例: 1）。未設定だとIP単位のログイン試行制限が全員まとめて数えられる
TRUST_PROXY=
